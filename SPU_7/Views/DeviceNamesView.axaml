<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:viewModels1="clr-namespace:SPU_7.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SPU_7.Views.DeviceNamesView"
             x:CompileBindings="False"
             Width="700"
             Height="500">

    <Design.DataContext>
        <viewModels1:DeviceNamesViewModel />
    </Design.DataContext>

    <controls:Card Margin="5">
        <DockPanel>
            <Button Margin="5"
                    Command="{Binding OkCommand}"
                    Content="Ок"
                    DockPanel.Dock="Bottom"
                    HorizontalAlignment="Center" />
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Margin="5"
                        Command="{Binding AddNameCommand}">
                    <avalonia:MaterialIcon Kind="Add" />
                </Button>
                <Button Margin="5"
                        Command="{Binding RemoveNameCommand}"
                        IsEnabled="{Binding SelectedDeviceName, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <avalonia:MaterialIcon Kind="Delete" />
                </Button>
            </StackPanel>
            <ScrollViewer>
                <ListBox ItemsSource="{Binding DeviceNames}"
                         SelectedItem="{Binding SelectedDeviceName}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox UseFloatingWatermark="True"
                                     HorizontalAlignment="Stretch"
                                     Margin="5"
                                     Text="{Binding DeviceTypeInfo}"
                                     Watermark="Введите тип"
                                     assists:TextFieldAssist.Label="Тип СИ" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </controls:Card>
</UserControl>