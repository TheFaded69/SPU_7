<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SPU_7.Views.Settings.StandSettingsView"

             xmlns:controls="using:Material.Styles.Controls"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:assists="using:Material.Styles.Assists"
             xmlns:settings="clr-namespace:SPU_7.ViewModels.Settings"
             xmlns:convertors="clr-namespace:SPU_7.Views.Convertors"
             x:CompileBindings="False"
             Loaded="Control_OnLoaded"
             Opacity="0.94">

    <Design.DataContext>
        <settings:StandSettingsViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:ColorZone Padding="5"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Mode="PrimaryMid"
                            DockPanel.Dock="Top"
                            Height="56">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Width="46"
                        Height="46"
                        Command="{Binding CloseWindowCommand}"
                        ToolTip.Tip="Закрыть"
                        Classes="flat">
                    <materialIcons:MaterialIcon Kind="Close" Width="40" Height="40" Foreground="Black" />
                </Button>
                <TextBlock Margin="5"
                           Text="Настройки"
                           DockPanel.Dock="Left"
                           FontSize="20"
                           VerticalAlignment="Center" />
            </DockPanel>
        </controls:ColorZone>
        <Grid HorizontalAlignment="Center"
              DockPanel.Dock="Bottom"
              ColumnDefinitions="0.5*, 0.5*">
            <Button Margin="5"
                    Content="Сохранить"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveSettingsCommand}" />
            <Button Margin="5"
                    Content="Отмена"
                    Classes="flat"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Width="103"
                    Command="{Binding CancelCommand}" />
        </Grid>

        <DockPanel DockPanel.Dock="Top">
            <Button Classes="flat"
                    Margin="5"
                    Command="{Binding CreateNewSettingsProfile}">
                <materialIcons:MaterialIcon Kind="Add"
                                            Height="30"
                                            Width="30" />
            </Button>
            <Button Classes="flat"
                    Margin="5"
                    Command="{Binding CreateNewSettingsProfileFromOtherCommand}"
                    ToolTip.Tip="Создать новый профиль настроек на основе выбранного">
                <materialIcons:MaterialIcon Kind="ContentCopy"
                                            Height="30"
                                            Width="30" />
            </Button>
            <Button Classes="flat"
                    Margin="5"
                    Command="{Binding DeleteSettingsProfileCommand}"
                    ToolTip.Tip="Удалить выбранный профиль">
                <materialIcons:MaterialIcon Kind="Delete"
                                            Height="30"
                                            Width="30" />
            </Button>
            <ComboBox Margin="5"
                      ItemsSource="{Binding StandSettingsProfiles}"
                      SelectedItem="{Binding SelectedSettingsProfile}"
                      HorizontalAlignment="Stretch"
                      Theme="{StaticResource MaterialOutlineComboBox}"
                      assists:ComboBoxAssist.Label="Профиль настроек">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBox Text="{Binding ProfileName}"
                 DockPanel.Dock="Top"
                 Margin="5"
                 UseFloatingWatermark="True"
                 Watermark="Введите название профиля"
                 assists:TextFieldAssist.Label="Название профиля настроек" />

        <TabControl>
            <TabItem Header="Протокол"
                     IsVisible="{Binding IsProtocolVisible}">
                <controls:Card Margin="5">
                    <ScrollViewer>
                        <StackPanel Orientation="Vertical">
                            <TextBox Margin="5"
                                     assists:TextFieldAssist.Label="Тип предприятия-поверителя"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap"
                                     Text="{Binding ValidationVendorType}" />
                            <TextBox Margin="5"
                                     assists:TextFieldAssist.Label="Наименование предприятия-поверителя"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap"
                                     Text="{Binding ValidationVendorName}" />
                            <TextBox Margin="5"
                                     assists:TextFieldAssist.Label="Сокращенное наименование предприятия-поверителя"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap"
                                     Text="{Binding ValidationVendorShortName}" />
                            <TextBox Margin="5"
                                     assists:TextFieldAssist.Label="Номер предприятия-поверителя в реестре"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap"
                                     Text="{Binding ValidationVendorUniqueNumber}" />
                            <TextBox Margin="5"
                                     assists:TextFieldAssist.Label="Адрес предприятия-поверителя"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap"
                                     Text="{Binding ValidationVendorAddress}" />
                            <TextBox Margin="5"
                                     assists:TextFieldAssist.Label="Наименование, тип, разряд СИ"
                                     UseFloatingWatermark="True"
                                     Text="{Binding DeviceInfo}"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding VendorName}"
                                     assists:TextFieldAssist.Label="Предприятие-изготовитель"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding VendorDate}"
                                     assists:TextFieldAssist.Label="Дата производства"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding DeviceRangeInfo}"
                                     assists:TextFieldAssist.Label="Диапазон измерений"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding OwnerName}"
                                     assists:TextFieldAssist.Label="Кому принадлежит"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding LastValidationInfo}"
                                     assists:TextFieldAssist.Label="Серия и номер предыдущей поверки"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding ValidationDeviceInfo}"
                                     assists:TextFieldAssist.Label="Для поверки использовались следующие средства измерений"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding ValidationMethod}"
                                     assists:TextFieldAssist.Label="Методика поверки"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding TightnessInfo}"
                                     assists:TextFieldAssist.Label="Проверка на герметичность"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding OutsideCheckInfo}"
                                     assists:TextFieldAssist.Label="Внешний осмотр"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding DeviceTestInfo}"
                                     assists:TextFieldAssist.Label="Опробование"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                            <TextBox Margin="5"
                                     Text="{Binding PostInfo}"
                                     assists:TextFieldAssist.Label="Должность"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите данные"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </controls:Card>
            </TabItem>

            <TabItem Header="Мнемосхема"
                     IsVisible="{Binding IsMnemonicSchemeVisible}">
                <TabControl>

                    <TabItem Header="Линии">
                        <controls:Card Margin="5">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Bottom">
                                    <Button Margin="5"
                                            Command="{Binding AddLineCommand}">
                                        <materialIcons:MaterialIcon Kind="Add" />
                                    </Button>
                                    <Button Margin="5"
                                            Command="{Binding RemoveLineCommand}">
                                        <materialIcons:MaterialIcon Kind="Delete" />
                                    </Button>
                                </StackPanel>

                                <ScrollViewer>
                                    <ItemsControl Margin="5"
                                                  ItemsSource="{Binding LineViewModels}"
                                                  HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Expander Margin="5"
                                                              Header="{Binding LineNumber, Converter={convertors:IntToStringLineNumberConverter}}">

                                                        <DockPanel>
                                                            <controls:Card DockPanel.Dock="Top"
                                                                           Height="400"
                                                                           Margin="5">
                                                                <TabControl DockPanel.Dock="Top">

                                                                    <TabItem Header="Устройства">
                                                                        <DockPanel>
                                                                            <DockPanel DockPanel.Dock="Left"
                                                                                LastChildFill="False">
                                                                                <ComboBox
                                                                                    ItemsSource="{Binding StringDeviceLineTypes}"
                                                                                    SelectedItem="{Binding SelectedStringDeviceLineType}"
                                                                                    DockPanel.Dock="Top"
                                                                                    Width="200"
                                                                                    assists:ComboBoxAssist.Label="Тип СГ"
                                                                                    Theme="{StaticResource MaterialOutlineComboBox}"
                                                                                    Margin="5" />
                                                                                <CheckBox Content="Наличие реверса"
                                                                                    DockPanel.Dock="Top"
                                                                                    Margin="5"
                                                                                    IsChecked="{Binding IsReverseLine}" />
                                                                            </DockPanel>
                                                                            <DockPanel DockPanel.Dock="Right">

                                                                                <StackPanel Orientation="Horizontal"
                                                                                    HorizontalAlignment="Center"
                                                                                    DockPanel.Dock="Bottom">
                                                                                    <Button Margin="5"
                                                                                        Command="{Binding AddDeviceCommand}">
                                                                                        <materialIcons:MaterialIcon
                                                                                            Kind="Add" />
                                                                                    </Button>
                                                                                    <Button Margin="5"
                                                                                        Command="{Binding RemoveDeviceCommand}">
                                                                                        <materialIcons:MaterialIcon
                                                                                            Kind="Delete" />
                                                                                    </Button>
                                                                                </StackPanel>

                                                                                <ListBox
                                                                                    ItemsSource="{Binding DeviceViewModels}"
                                                                                    SelectedItem="{Binding SelectedDeviceViewModel}">
                                                                                    <ListBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <DockPanel>
                                                                                                
                                                                                            
                                                                                            <StackPanel DockPanel.Dock="Top"
                                                                                                Orientation="Horizontal">
                                                                                                <TextBlock Margin="5"
                                                                                                    Text="{Binding Number, Converter={convertors:IntToStringNumberConverter}}"
                                                                                                    VerticalAlignment="Center" />

                                                                                                <TextBox
                                                                                                    Text="{Binding PressureSensorAddress}"
                                                                                                    Margin="5"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес (0-255)"
                                                                                                    assists:TextFieldAssist.Label="Адрес датчика давления" />

                                                                                                <TextBox
                                                                                                    Text="{Binding PulseMeterNumber}"
                                                                                                    Margin="5"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите номер"
                                                                                                    assists:TextFieldAssist.Label="Адрес БИПЧ" />

                                                                                                <TextBox
                                                                                                    Text="{Binding PulseMeterChannelNumber}"
                                                                                                    Margin="5"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите номер"
                                                                                                    assists:TextFieldAssist.Label="Номер канала БИПЧ" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес модуля"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    Text="{Binding Address}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр в модуле"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    Text="{Binding RegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Номер бита"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    Text="{Binding BitNumber}" />


                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес состояния модуля"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    Text="{Binding StateAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр состояния в модуле"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    Text="{Binding StateRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Номер бита состояния"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    Text="{Binding StateBitNumber}" />

                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding IsControlState}"
                                                                                                    Content="Контроль состояния"
                                                                                                    IsVisible="{Binding IsValveEnable}"
                                                                                                    VerticalAlignment="Center" />

                                                                                                <ComboBox Margin="5"
                                                                                                    Width="300"
                                                                                                    SelectedItem="{Binding SelectedCameraName}"
                                                                                                    ItemsSource="{Binding CameraNames}"
                                                                                                    assists:ComboBoxAssist.Label="Название камеры"
                                                                                                    Theme="{StaticResource MaterialOutlineComboBox}" />

                                                                                            </StackPanel>
                                                                                                <StackPanel DockPanel.Dock="Top"
                                                                                                    Orientation="Horizontal">
                                                                                                    <TextBox Margin="5"
                                                                                                        assists:TextFieldAssist.Label="Номер МПКИ"
                                                                                                        UseFloatingWatermark="True"
                                                                                                        Watermark="Введите номер"
                                                                                                        Text="{Binding PulseCountMeterModuleNumber}" />
                                                                                                    <TextBox Margin="5"
                                                                                                        assists:TextFieldAssist.Label="Канал МПКИ"
                                                                                                        UseFloatingWatermark="True"
                                                                                                        Watermark="Введите номер"
                                                                                                        Text="{Binding PulseCountMeterModuleChannelNumber}" />
                                                                                                </StackPanel>
                                                                                            </DockPanel>
                                                                                        </DataTemplate>
                                                                                    </ListBox.ItemTemplate>
                                                                                </ListBox>
                                                                            </DockPanel>
                                                                        </DockPanel>
                                                                    </TabItem>

                                                                    <TabItem Header="Мастер-устройства">
                                                                        <DockPanel DockPanel.Dock="Right">

                                                                            <StackPanel Orientation="Horizontal"
                                                                                HorizontalAlignment="Center"
                                                                                DockPanel.Dock="Bottom">
                                                                                <Button Margin="5"
                                                                                    Command="{Binding AddMasterDeviceCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Add" />
                                                                                </Button>
                                                                                <Button Margin="5"
                                                                                    Command="{Binding RemoveMasterDeviceCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Delete" />
                                                                                </Button>
                                                                            </StackPanel>


                                                                            <ListBox
                                                                                ItemsSource="{Binding MasterDeviceViewModels}"
                                                                                SelectedItem="{Binding SelectedMasterDeviceViewModel}">
                                                                                <ListBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <DockPanel>
                                                                                            <StackPanel
                                                                                                DockPanel.Dock="Top"
                                                                                                Orientation="Horizontal">
                                                                                                <ComboBox
                                                                                                    DockPanel.Dock="Left"
                                                                                                    Width="300"
                                                                                                    ItemsSource="{Binding MasterDeviceTypesString}"
                                                                                                    SelectedItem="{Binding SelectedMasterDeviceTypeString}"
                                                                                                    Margin="5"
                                                                                                    assists:ComboBoxAssist.Label="Тип мастера-устройства"
                                                                                                    Theme="{StaticResource MaterialOutlineComboBox}" />
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Наименование"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Text="{Binding MasterDeviceName}" />
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Заводской номер"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Text="{Binding VendorNumber}" />
                                                                                                <ComboBox
                                                                                                    IsVisible="{Binding IsConnectionInfoVisible}"
                                                                                                    DockPanel.Dock="Left"
                                                                                                    Width="300"
                                                                                                    ItemsSource="{Binding PortNames}"
                                                                                                    SelectedItem="{Binding SelectedComPort}"
                                                                                                    Margin="5"
                                                                                                    assists:ComboBoxAssist.Label="Порт мастер-устройства"
                                                                                                    Theme="{StaticResource MaterialOutlineComboBox}" />
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес мастер-устройства"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    IsVisible="{Binding IsConnectionInfoVisible}"
                                                                                                    Text="{Binding MasterDeviceAddress}" />
                                                                                                <ComboBox
                                                                                                    DockPanel.Dock="Left"
                                                                                                    Width="300"
                                                                                                    ItemsSource="{Binding PortNames}"
                                                                                                    SelectedItem="{Binding SelectedPressureSensorComPort}"
                                                                                                    Margin="5"
                                                                                                    assists:ComboBoxAssist.Label="Порт ДД"
                                                                                                    Theme="{StaticResource MaterialOutlineComboBox}" />
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес ДД"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Text="{Binding PressureSensorAddress}" />
                                                                                                <ComboBox
                                                                                                    DockPanel.Dock="Left"
                                                                                                    Width="300"
                                                                                                    ItemsSource="{Binding PortNames}"
                                                                                                    SelectedItem="{Binding SelectedTemperatureSensorComPort}"
                                                                                                    Margin="5"
                                                                                                    assists:ComboBoxAssist.Label="Порт ДТ"
                                                                                                    Theme="{StaticResource MaterialOutlineComboBox}" />
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес ДТ"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Text="{Binding TemperatureSensorAddress}" />
                                                                                            </StackPanel>
                                                                                            <StackPanel
                                                                                                DockPanel.Dock="Top"
                                                                                                Orientation="Horizontal">

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес модуля"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  MasterDeviceValveViewModel.Address}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр в модуле"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding MasterDeviceValveViewModel.RegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Номер бита"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding MasterDeviceValveViewModel.BitNumber}" />


                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding MasterDeviceValveViewModel.StateOnAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding MasterDeviceValveViewModel.StateOnRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Бит ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding MasterDeviceValveViewModel.StateOnBitNumber}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding MasterDeviceValveViewModel.StateOffAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding MasterDeviceValveViewModel.StateOffRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Бит OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding MasterDeviceValveViewModel.StateOffBitNumber}" />

                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding MasterDeviceValveViewModel.IsControlState}"
                                                                                                    Content="Контроль состояния"
                                                                                                    VerticalAlignment="Center" />
                                                                                                
                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding MasterDeviceValveViewModel.IsReverseValve}"
                                                                                                    Content="Обратное управление"
                                                                                                    VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                            <StackPanel
                                                                                                DockPanel.Dock="Top"
                                                                                                Orientation="Horizontal">

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес модуля"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  PressureSensorValveViewModel.Address}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр в модуле"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding PressureSensorValveViewModel.RegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Номер бита"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding PressureSensorValveViewModel.BitNumber}" />


                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding PressureSensorValveViewModel.StateOnAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding PressureSensorValveViewModel.StateOnRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Бит ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding PressureSensorValveViewModel.StateOnBitNumber}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding PressureSensorValveViewModel.StateOffAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding PressureSensorValveViewModel.StateOffRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Бит OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding PressureSensorValveViewModel.StateOffBitNumber}" />

                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding PressureSensorValveViewModel.IsControlState}"
                                                                                                    Content="Контроль состояния"
                                                                                                    VerticalAlignment="Center" />
                                                                                                
                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding PressureSensorValveViewModel.IsReverseValve}"
                                                                                                    Content="Обратное управление"
                                                                                                    VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                            <StackPanel DockPanel.Dock="Top"
                                                                                                        Orientation="Horizontal">
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Номер МПКИ"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите номер"
                                                                                                    Text="{Binding PulseCountMeterModuleNumber}" />
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Канал МПКИ"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите номер"
                                                                                                    Text="{Binding PulseCountMeterModuleChannelNumber}" />
                                                                                            </StackPanel>
                                                                                        </DockPanel>

                                                                                    </DataTemplate>
                                                                                </ListBox.ItemTemplate>
                                                                            </ListBox>
                                                                        </DockPanel>
                                                                    </TabItem>

                                                                    <TabItem Header="Сопла">
                                                                        <DockPanel>
                                                                            <StackPanel DockPanel.Dock="Bottom"
                                                                                HorizontalAlignment="Center"
                                                                                Orientation="Horizontal">
                                                                                <Button Margin="5"
                                                                                    Command="{Binding AddNozzleCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Add" />
                                                                                </Button>

                                                                                <Button Margin="5"
                                                                                    Command="{Binding RemoveNozzleCommand}"
                                                                                    IsEnabled="{Binding SelectedNozzleViewModels, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Delete" />
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <StackPanel DockPanel.Dock="Top"
                                                                                Orientation="Horizontal">

                                                                            </StackPanel>

                                                                            <StackPanel DockPanel.Dock="Top"
                                                                                Orientation="Horizontal">

                                                                            </StackPanel>

                                                                            <ListBox Margin="5"
                                                                                ItemsSource="{Binding NozzleViewModels}"
                                                                                SelectedItem="{Binding SelectedNozzleViewModel}">
                                                                                <ListBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel
                                                                                            Orientation="Horizontal">
                                                                                            <TextBlock Margin="5"
                                                                                                Text="{Binding Number, Converter={convertors:IntToStringNumberConverter}}"
                                                                                                VerticalAlignment="Center" />

                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Расход сопла, м3/ч"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark="Введите расход"
                                                                                                Text="{Binding NozzleValue}" />
                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Расход сопла фактический, м3/ч"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark="Введите расход"
                                                                                                Text="{Binding NozzleFactValue}" />
                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Адрес модуля"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark="Введите адрес"
                                                                                                Text="{Binding Address}" />

                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Регистр в модуле"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark="Введите hex"
                                                                                                Text="{Binding RegisterAddress}" />

                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Номер бита"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark=""
                                                                                                Text="{Binding BitNumber}" />

                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Адрес состояния модуля"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark="Введите адрес"
                                                                                                Text="{Binding StateAddress}" />

                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Регистр состояния в модуле"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark="Введите hex"
                                                                                                Text="{Binding StateRegisterAddress}" />

                                                                                            <TextBox Margin="5"
                                                                                                assists:TextFieldAssist.Label="Номер бита состояния"
                                                                                                UseFloatingWatermark="True"
                                                                                                Watermark=""
                                                                                                Text="{Binding StateBitNumber}" />

                                                                                            <CheckBox Margin="5"
                                                                                                IsChecked="{Binding IsControlState}"
                                                                                                Content="Контроль состояния"
                                                                                                VerticalAlignment="Center" />

                                                                                            <CheckBox Margin="5"
                                                                                                IsChecked="{Binding IsReplaceNozzle}"
                                                                                                Content="Заменяемое сопло"
                                                                                                VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ListBox.ItemTemplate>
                                                                            </ListBox>
                                                                        </DockPanel>
                                                                    </TabItem>

                                                                    <TabItem Header="Вентиляторы">
                                                                        <DockPanel DockPanel.Dock="Right">

                                                                            <StackPanel Orientation="Horizontal"
                                                                                HorizontalAlignment="Center"
                                                                                DockPanel.Dock="Bottom">
                                                                                <Button Margin="5"
                                                                                    Command="{Binding AddFanCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Add" />
                                                                                </Button>
                                                                                <Button Margin="5"
                                                                                    Command="{Binding RemoveFanCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Delete" />
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <ListBox
                                                                                ItemsSource="{Binding FanViewModels}"
                                                                                SelectedItem="{Binding SelectedFanViewModel}">
                                                                                <ListBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <DockPanel>
                                                                                            <StackPanel
                                                                                                DockPanel.Dock="Top"
                                                                                                Orientation="Horizontal">

                                                                                                <CheckBox Margin="5"
                                                                                                    Content="Шаровой кран"
                                                                                                    IsChecked="{Binding IsValveEnable}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес модуля"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  FanValveViewModel.Address}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр в модуле"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding FanValveViewModel.RegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Номер бита"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding FanValveViewModel.BitNumber}" />


                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding FanValveViewModel.StateOnAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding FanValveViewModel.StateOnRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Бит ON"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding FanValveViewModel.StateOnBitNumber}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding FanValveViewModel.StateOffAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Регистр OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите hex"
                                                                                                    Text="{Binding FanValveViewModel.StateOffRegisterAddress}" />

                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Бит OFF"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark=""
                                                                                                    Text="{Binding FanValveViewModel.StateOffBitNumber}" />

                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding FanValveViewModel.IsControlState}"
                                                                                                    Content="Контроль состояния"
                                                                                                    VerticalAlignment="Center" />
                                                                                                
                                                                                                <CheckBox Margin="5"
                                                                                                    IsChecked="{Binding FanValveViewModel.IsReverseValve}"
                                                                                                    Content="Обратное управление"
                                                                                                    VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                            <StackPanel
                                                                                                DockPanel.Dock="Bottom"
                                                                                                Orientation="Horizontal">

                                                                                                <CheckBox Margin="5"
                                                                                                    Content="Игольчатый клапан"
                                                                                                    IsChecked="{Binding IsNeedleValveEnable}" />

                                                                                            </StackPanel>
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <ComboBox Margin="5"
                                                                                                    Width="300"
                                                                                                    assists:ComboBoxAssist.Label="Порт подключения ПЧВ"
                                                                                                    Theme="{StaticResource MaterialOutlineComboBox}" 
                                                                                                    ItemsSource="{Binding FrequencyRegulatorViewModel.PortNames}"
                                                                                                    SelectedItem="{Binding FrequencyRegulatorViewModel.PortName}"/>
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Адрес модуля"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.ModuleAddress}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="kP"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите коэффициент"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.kP}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="kI"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите коэффициент"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.kI}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="kD"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите коэффициент"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.kD}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Минимальное входное значение"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.pvMin}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Максимальное входное значение"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.pvMax}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Минимальное выходное значение"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.outMin}" />
                                                                                                
                                                                                                <TextBox Margin="5"
                                                                                                    assists:TextFieldAssist.Label="Максимальное выходное значение"
                                                                                                    UseFloatingWatermark="True"
                                                                                                    Watermark="Введите адрес"
                                                                                                    Text="{Binding  FrequencyRegulatorViewModel.outMax}" />
                                                                                                
                                                                                            </StackPanel>
                                                                                        </DockPanel>


                                                                                    </DataTemplate>
                                                                                </ListBox.ItemTemplate>
                                                                            </ListBox>
                                                                        </DockPanel>
                                                                    </TabItem>

                                                                    <TabItem Header="Вакуумные насосы">
                                                                        <DockPanel DockPanel.Dock="Right">

                                                                            <StackPanel Orientation="Horizontal"
                                                                                HorizontalAlignment="Center"
                                                                                DockPanel.Dock="Bottom">
                                                                                <Button Margin="5"
                                                                                    Command="{Binding AddVacuumValveCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Add" />
                                                                                </Button>
                                                                                <Button Margin="5"
                                                                                    Command="{Binding RemoveVacuumValveCommand}">
                                                                                    <materialIcons:MaterialIcon
                                                                                        Kind="Delete" />
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <ListBox
                                                                                ItemsSource="{Binding VacuumValveViewModels}"
                                                                                SelectedItem="{Binding SelectedVacuumValveViewModel}">
                                                                                <ListBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel
                                                                                            Orientation="Horizontal">
                                                                                            <ComboBox
                                                                                                DockPanel.Dock="Left"
                                                                                                Width="300"
                                                                                                Margin="5"
                                                                                                assists:ComboBoxAssist.Label="Тип вакуумного насоса"
                                                                                                Theme="{StaticResource MaterialOutlineComboBox}" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ListBox.ItemTemplate>
                                                                            </ListBox>
                                                                        </DockPanel>
                                                                    </TabItem>

                                                                </TabControl>
                                                            </controls:Card>

                                                            <DockPanel DockPanel.Dock="Top"
                                                                       LastChildFill="False">
                                                                <ComboBox DockPanel.Dock="Left"
                                                                          Width="300"
                                                                          Margin="5"
                                                                          ItemsSource="{Binding StringLineTypes}"
                                                                          SelectedItem="{Binding SelectedStringLineType}"
                                                                          assists:ComboBoxAssist.Label="Тип линии"
                                                                          Theme="{StaticResource MaterialOutlineComboBox}" />
                                                            </DockPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsAfterDeviceValve}"
                                                                          Content="Кран после линии устройств" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding  AfterDeviceValveViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding AfterDeviceValveViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding AfterDeviceValveViewModel.BitNumber}" />


                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Адрес ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding AfterDeviceValveViewModel.StateOnAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Регистр ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding AfterDeviceValveViewModel.StateOnRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Бит ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding AfterDeviceValveViewModel.StateOnBitNumber}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Адрес OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding AfterDeviceValveViewModel.StateOffAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Регистр OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding AfterDeviceValveViewModel.StateOffRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsAfterDeviceValve}"
                                                                         assists:TextFieldAssist.Label="Бит OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding AfterDeviceValveViewModel.StateOffBitNumber}" />

                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsAfterDeviceValve}"
                                                                          IsChecked="{Binding AfterDeviceValveViewModel.IsControlState}"
                                                                          Content="Контроль состояния"
                                                                          VerticalAlignment="Center" />
                                                                
                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsAfterDeviceValve}"
                                                                          IsChecked="{Binding AfterDeviceValveViewModel.IsReverseValve}"
                                                                          Content="Обратное управление"
                                                                          VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsStartCommonValve}"
                                                                          Content="Общий кран перед мастер-устройствами" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding  StartCommonValveViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding StartCommonValveViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding StartCommonValveViewModel.BitNumber}" />


                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Адрес ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding StartCommonValveViewModel.StateOnAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Регистр ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding StartCommonValveViewModel.StateOnRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Бит ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding StartCommonValveViewModel.StateOnBitNumber}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Адрес OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding StartCommonValveViewModel.StateOffAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Регистр OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding StartCommonValveViewModel.StateOffRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartCommonValve}"
                                                                         assists:TextFieldAssist.Label="Бит OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding StartCommonValveViewModel.StateOffBitNumber}" />

                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsStartCommonValve}"
                                                                          IsChecked="{Binding StartCommonValveViewModel.IsControlState}"
                                                                          Content="Контроль состояния"
                                                                          VerticalAlignment="Center" />
                                                                
                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsStartCommonValve}"
                                                                          IsChecked="{Binding StartCommonValveViewModel.IsReverseValve}"
                                                                          Content="Обратное управление"
                                                                          VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsEndCommonValve}"
                                                                          Content="Общий кран после мастер-устройств" />
                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         Text="{Binding EndCommonValveViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         Text="{Binding EndCommonValveViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         Text="{Binding EndCommonValveViewModel.BitNumber}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         assists:TextFieldAssist.Label="Адрес ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding EndCommonValveViewModel.StateOnAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         assists:TextFieldAssist.Label="Регистр ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding EndCommonValveViewModel.StateOnRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         assists:TextFieldAssist.Label="Бит ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding EndCommonValveViewModel.StateOnBitNumber}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         assists:TextFieldAssist.Label="Адрес OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding EndCommonValveViewModel.StateOffAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         assists:TextFieldAssist.Label="Регистр OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding EndCommonValveViewModel.StateOffRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndCommonValve}"
                                                                         assists:TextFieldAssist.Label="Бит OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding EndCommonValveViewModel.StateOffBitNumber}" />

                                                                <CheckBox Margin="5"
                                                                          IsChecked="{Binding EndCommonValveViewModel.IsControlState}"
                                                                          Content="Контроль состояния"
                                                                          IsVisible="{Binding IsEndCommonValve}"
                                                                          VerticalAlignment="Center" />
                                                                
                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsEndCommonValve}"
                                                                          IsChecked="{Binding EndCommonValveViewModel.IsReverseValve}"
                                                                          Content="Обратное управление"
                                                                          VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsStartValveMasterDevice}"
                                                                          Content="Кран перед мастер-устройствами" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding  StartValveMasterDeviceViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding StartValveMasterDeviceViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding StartValveMasterDeviceViewModel.BitNumber}" />


                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Адрес ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding StartValveMasterDeviceViewModel.StateOnAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Регистр ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding StartValveMasterDeviceViewModel.StateOnRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Бит ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding StartValveMasterDeviceViewModel.StateOnBitNumber}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Адрес OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding StartValveMasterDeviceViewModel.StateOffAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Регистр OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding StartValveMasterDeviceViewModel.StateOffRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsStartValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Бит OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding StartValveMasterDeviceViewModel.StateOffBitNumber}" />

                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsStartValveMasterDevice}"
                                                                          IsChecked="{Binding StartValveMasterDeviceViewModel.IsControlState}"
                                                                          Content="Контроль состояния"
                                                                          VerticalAlignment="Center" />
                                                                
                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsStartValveMasterDevice}"
                                                                          IsChecked="{Binding StartValveMasterDeviceViewModel.IsReverseValve}"
                                                                          Content="Обратное управление"
                                                                          VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsEndValveMasterDevice}"
                                                                          Content="Кран после мастер-устройств" />
                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.BitNumber}" />


                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Адрес ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.StateOnAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Регистр ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.StateOnRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Бит ON"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding EndValveMasterDeviceViewModel.StateOnBitNumber}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Адрес OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.StateOffAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Регистр OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         Text="{Binding EndValveMasterDeviceViewModel.StateOffRegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         IsVisible="{Binding IsEndValveMasterDevice}"
                                                                         assists:TextFieldAssist.Label="Бит OFF"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         Text="{Binding EndValveMasterDeviceViewModel.StateOffBitNumber}" />

                                                                <CheckBox Margin="5"
                                                                          IsChecked="{Binding EndValveMasterDeviceViewModel.IsControlState}"
                                                                          Content="Контроль состояния"
                                                                          IsVisible="{Binding IsEndValveMasterDevice}"
                                                                          VerticalAlignment="Center" />
                                                                
                                                                <CheckBox Margin="5"
                                                                          IsVisible="{Binding IsEndValveMasterDevice}"
                                                                          IsChecked="{Binding EndValveMasterDeviceViewModel.IsReverseValve}"
                                                                          Content="Обратное управление"
                                                                          VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsOpenNormalSolenoidValve}"
                                                                          Content="Нормально открытый соленоид перед группой расхода" />
                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         IsVisible="{Binding IsOpenNormalSolenoidValve}"
                                                                         Text="{Binding OpenNormalSolenoidValveViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         IsVisible="{Binding IsOpenNormalSolenoidValve}"
                                                                         Text="{Binding OpenNormalSolenoidValveViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         IsVisible="{Binding IsOpenNormalSolenoidValve}"
                                                                         Text="{Binding OpenNormalSolenoidValveViewModel.BitNumber}" />

                                                                <ComboBox Margin="5"
                                                                          Width="300"
                                                                          ItemsSource="{Binding OpenNormalSolenoidValveViewModel.StringSolenoidValveTypes}"
                                                                          SelectedItem="{Binding OpenNormalSolenoidValveViewModel.SelectedStringSolenoidValveType}"
                                                                          assists:ComboBoxAssist.Label="Тип соленоидного клапана"
                                                                          Theme="{StaticResource MaterialOutlineComboBox}" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsCloseNormalSolenoidValve}"
                                                                          Content="Нормально закрытый соленоид перед группой расхода" />
                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Адрес модуля"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите адрес"
                                                                         IsVisible="{Binding IsCloseNormalSolenoidValve}"
                                                                         Text="{Binding CloseNormalSolenoidValveViewModel.Address}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Регистр в модуле"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark="Введите hex"
                                                                         IsVisible="{Binding IsCloseNormalSolenoidValve}"
                                                                         Text="{Binding CloseNormalSolenoidValveViewModel.RegisterAddress}" />

                                                                <TextBox Margin="5"
                                                                         assists:TextFieldAssist.Label="Номер бита"
                                                                         UseFloatingWatermark="True"
                                                                         Watermark=""
                                                                         IsVisible="{Binding IsCloseNormalSolenoidValve}"
                                                                         Text="{Binding CloseNormalSolenoidValveViewModel.BitNumber}" />

                                                                <ComboBox Margin="5"
                                                                          Width="300"
                                                                          ItemsSource="{Binding CloseNormalSolenoidValveViewModel.StringSolenoidValveTypes}"
                                                                          SelectedItem="{Binding CloseNormalSolenoidValveViewModel.SelectedStringSolenoidValveType}"
                                                                          assists:ComboBoxAssist.Label="Тип соленоидного клапана"
                                                                          Theme="{StaticResource MaterialOutlineComboBox}" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsCheckTightnessLine}"
                                                                          Content="Линия проверки герметичности" />
                                                            </StackPanel>

                                                            <StackPanel DockPanel.Dock="Top"
                                                                        Orientation="Horizontal">
                                                                <CheckBox Margin="5, 20, 5, 22"
                                                                          IsChecked="{Binding IsDropValveEnable}"
                                                                          Content="Кран сброса расхода" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Expander>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                        </controls:Card>
                    </TabItem>

                    <TabItem Header="БИПЧ">
                        <controls:Card Margin="5">
                            <DockPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Bottom">
                                    <Button Margin="5"
                                            Command="{Binding AddPulseMeterCommand}">
                                        <materialIcons:MaterialIcon Kind="Add" />
                                    </Button>
                                    <Button Margin="5"
                                            Command="{Binding RemovePulseMeterCommand}">
                                        <materialIcons:MaterialIcon Kind="Delete" />
                                    </Button>
                                </StackPanel>

                                <ListBox Margin="5"
                                         ItemsSource="{Binding PulseMeterViewModels}"
                                         SelectedItem="{Binding SelectedPulseMeterViewModel}"
                                         HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="5"
                                                           Text="{Binding Number, Converter={convertors:IntToStringNumberConverter}}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Margin="5"
                                                         assists:TextFieldAssist.Label="Адрес БИПЧ"
                                                         UseFloatingWatermark="True"
                                                         Watermark="Введите адрес"
                                                         Text="{Binding Address}" />

                                                <TextBox Margin="5"
                                                         assists:TextFieldAssist.Label="Корректировочный коэффициент 1"
                                                         UseFloatingWatermark="True"
                                                         Watermark="Введите значение"
                                                         Text="{Binding FirstCalibrateCoefficient}" />

                                                <TextBox Margin="5"
                                                         assists:TextFieldAssist.Label="Корректировочный коэффициент 2"
                                                         UseFloatingWatermark="True"
                                                         Watermark="Введите значение"
                                                         Text="{Binding SecondCalibrateCoefficient}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ListBox>

                            </DockPanel>
                        </controls:Card>
                    </TabItem>

                    <TabItem Header="МПКИ">
                        <controls:Card Margin="5">
                            <DockPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            DockPanel.Dock="Bottom">
                                    <Button Margin="5"
                                            Command="{Binding AddPulseCountMeterModuleCommand}">
                                        <materialIcons:MaterialIcon Kind="Add" />
                                    </Button>
                                    <Button Margin="5"
                                            Command="{Binding RemovePulseCountMeterModuleCommand}">
                                        <materialIcons:MaterialIcon Kind="Delete" />
                                    </Button>
                                </StackPanel>

                                <ListBox Margin="5"
                                         ItemsSource="{Binding PulseCountMeterModuleViewModels}"
                                         SelectedItem="{Binding SelectedPulseCountMeterModuleViewModel}"
                                         HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="5"
                                                           Text="{Binding Number, Converter={convertors:IntToStringNumberConverter}}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Margin="5"
                                                         assists:TextFieldAssist.Label="Адрес МПКИ"
                                                         UseFloatingWatermark="True"
                                                         Watermark="Введите адрес"
                                                         Text="{Binding ModuleAddress}" />
                                                
                                                <ComboBox Margin="5"
                                                          Width="300"
                                                          ItemsSource="{Binding PortNames}"
                                                          SelectedItem="{Binding PortName}"
                                                          assists:ComboBoxAssist.Label="Порт подключения МПКИ"
                                                          Theme="{StaticResource MaterialOutlineComboBox}" />
                                                
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ListBox>

                            </DockPanel>
                        </controls:Card>
                    </TabItem>
                    
                </TabControl>
            </TabItem>

            <TabItem Header="Оборудование"
                     IsVisible="{Binding IsDeviceVisible}">
                <controls:Card Margin="5">
                    <DockPanel LastChildFill="False">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                              ColumnDefinitions="0.25*, 0.25*, 0.25*, 0.25*"
                              DockPanel.Dock="Top">
                            <ComboBox Grid.Row="0"
                                      Grid.Column="0"
                                      Theme="{StaticResource MaterialOutlineComboBox}"
                                      Margin="5"
                                      ItemsSource="{Binding PortNames}"
                                      SelectedItem="{Binding SelectedEquipmentPortName}"
                                      assists:ComboBoxAssist.Label="Порт управления стендом" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="5"
                                     UseFloatingWatermark="True"
                                     Watermark="хз"
                                     assists:TextFieldAssist.Label="Запасное поле" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="2"
                                      Theme="{StaticResource MaterialOutlineComboBox}"
                                      Margin="5"
                                      ItemsSource="{Binding PortNames}"
                                      SelectedItem="{Binding SelectedPressureSensorPortName}"
                                      assists:ComboBoxAssist.Label="Порт датчика давления" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="3"
                                     Margin="5"
                                     UseFloatingWatermark="True"
                                     Text="{Binding PressureSensorAddress}"
                                     Watermark="Введите адрес"
                                     assists:TextFieldAssist.Label="Адрес датчика давления" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="0"
                                      Margin="5"
                                      Theme="{StaticResource MaterialOutlineComboBox}"
                                      ItemsSource="{Binding PortNames}"
                                      SelectedItem="{Binding SelectedPressureDifferenceSensorPortName}"
                                      assists:ComboBoxAssist.Label="Порт управления датчиком перепада" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="5"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите адрес"
                                     Text="{Binding PressureDifferenceSensorAddress}"
                                     assists:TextFieldAssist.Label="Адрес датчика перепада" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      Margin="5"
                                      Theme="{StaticResource MaterialOutlineComboBox}"
                                      ItemsSource="{Binding PortNames}"
                                      SelectedItem="{Binding SelectedPressureResiverSensorPortName}"
                                      assists:ComboBoxAssist.Label="Порт датчика давления ресивера" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Margin="5"
                                     UseFloatingWatermark="True"
                                     Text="{Binding PressureResiverSensorAddress}"
                                     Watermark="Введите адрес"
                                     assists:TextFieldAssist.Label="Адрес датчика давления ресивера" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="0"
                                      Margin="5"
                                      Theme="{StaticResource MaterialOutlineComboBox}"
                                      ItemsSource="{Binding PortNames}"
                                      SelectedItem="{Binding SelectedTemperatureSensorPortName}"
                                      assists:ComboBoxAssist.Label="Порт датчика температуры" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="5"
                                     UseFloatingWatermark="True"
                                     Watermark="Введите адрес"
                                     Text="{Binding TemperatureSensorAddress}"
                                     assists:TextFieldAssist.Label="Адрес датчика температуры" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="2"
                                      Margin="5"
                                      Theme="{StaticResource MaterialOutlineComboBox}"
                                      ItemsSource="{Binding PortNames}"
                                      SelectedItem="{Binding SelectedTHMeterPortName}"
                                      assists:ComboBoxAssist.Label="Порт датчика ИВА" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="3"
                                     Margin="5"
                                     UseFloatingWatermark="True"
                                     Text="{Binding THMeterAddress}"
                                     Watermark="Введите адрес"
                                     assists:TextFieldAssist.Label="Адрес датчика ИВА" />
                        </Grid>

                        <StackPanel DockPanel.Dock="Bottom"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Margin="5"
                                    Command="{Binding AddPortCommand}">
                                <materialIcons:MaterialIcon Kind="Add" />
                            </Button>

                            <Button Margin="5"
                                    Command="{Binding RemovePortCommand}"
                                    IsEnabled="{Binding SelectedPortViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <materialIcons:MaterialIcon Kind="Delete" />
                            </Button>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Margin="5"
                                   HorizontalAlignment="Center"
                                   Text="Настройка портов" />

                        <ListBox Margin="5"
                                 ItemsSource="{Binding PortViewModels}"
                                 SelectedItem="{Binding SelectedPortViewModel}"
                                 HorizontalAlignment="Center"
                                 DockPanel.Dock="Top">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Margin="5"
                                                  ItemsSource="{Binding PortNames}"
                                                  SelectedItem="{Binding PortName}"
                                                  assists:ComboBoxAssist.Label="Порт"
                                                  Width="300"
                                                  Theme="{StaticResource MaterialOutlineComboBox}" />
                                        <ComboBox Margin="5"
                                                  ItemsSource="{Binding PortBaudRates}"
                                                  SelectedItem="{Binding PortBaudRate}"
                                                  assists:ComboBoxAssist.Label="Скорость порта"
                                                  Width="300"
                                                  Theme="{StaticResource MaterialOutlineComboBox}" />

                                        <ComboBox Margin="5"
                                                  ItemsSource="{Binding StopBits}"
                                                  SelectedItem="{Binding SelectedStopBitDouble}"
                                                  assists:ComboBoxAssist.Label="Стоп бит"
                                                  Width="300"
                                                  Theme="{StaticResource MaterialOutlineComboBox}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </controls:Card>
            </TabItem>
        </TabControl>
    </DockPanel>


</UserControl>