<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:extensionViewModels="clr-namespace:SPU_7.ViewModels.ExtensionViewModels"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:DataType="extensionViewModels:PulseCountMeterModuleTestViewModel"
             x:Class="SPU_7.Views.ExtensionViews.PulseCountMeterModuleTestView"
             Loaded="Control_OnLoaded">
    <Design.DataContext>
        <extensionViewModels:PulseCountMeterModuleTestViewModel/>
    </Design.DataContext>
    
    <controls:Card MinWidth="500"
                   MinHeight="300">
        
        <DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       LastChildFill="False">
                <Button DockPanel.Dock="Right" 
                        Width="46" 
                        Height="46"
                        Command="{Binding CloseWindowCommand}"
                        ToolTip.Tip="Закрыть"
                        Classes="flat">
                    <avalonia:MaterialIcon Kind="Close" Width="40" Height="40" Foreground="Black"/>
                </Button>
                  
                <TextBlock Margin="5"
                           FontSize="20"
                           Text="{Binding Title}"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>
            </DockPanel>
            
            <Grid ColumnDefinitions="0.5*, 0.5*"
                  RowDefinitions="Auto, *">
                
                <ComboBox Grid.Row="0"
                          Grid.Column="0" 
                          Grid.ColumnSpan="2"
                          Margin="5"
                          Classes="Outline"
                          assists:ComboBoxAssist.Label="Поверяемый канал"
                          Theme="{StaticResource MaterialOutlineComboBox}"
                          ItemsSource="{Binding DeviceInformation}"
                          SelectedItem="{Binding SelectedDevicePulseCountMeterModuleViewModel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="5"
                                           Text="{Binding LineNumber, StringFormat='Линия - №{0}'}"/>
                                <!--TextBlock Margin="5"
                                           Text="{Binding DeviceNumber, StringFormat='Устройство - №{0}'}"/>
                                <TextBlock Margin="5"
                                           Text="{Binding ChannelNumber, StringFormat='Канал - №{0}'}"/-->
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!--TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="5"
                         UseFloatingWatermark="True" 
                         Watermark="Введите номер канала МПКИ" 
                         assists:TextFieldAssist.Label="Номер канала МПКИ"
                         Text="{Binding ChannelNumber }"/-->
                <DockPanel Grid.Row="1"
                           Grid.Column="0"
                           LastChildFill="False">
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="0.5*, 0.5*">
                        <Button DockPanel.Dock="Bottom"
                                Grid.Column="0"
                                Classes="flat"
                                Width="60"
                                Height="60"
                                Margin="5"
                                IsEnabled="{Binding !IsPulseCountWork}"
                                Command="{Binding StartPulseCountCommand}">
                            <avalonia:MaterialIcon Kind="Play" Width="50" Height="50"/>
                        </Button>
                        <Button DockPanel.Dock="Bottom"
                                Grid.Column="1"
                                Width="50"
                                Height="50"
                                Classes="flat"
                                Margin="5"
                                IsEnabled="{Binding IsPulseCountWork}"
                                Command="{Binding StopPulseCountCommand}">
                            <avalonia:MaterialIcon Kind="Stop" Width="50" Height="50"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock DockPanel.Dock="Bottom"
                               VerticalAlignment="Center"
                               Margin="5"
                               Text="{Binding PulseCount, StringFormat='Количество импульсов: {0}'}"/>
                </DockPanel>
                
                <DockPanel Grid.Row="1"
                           Grid.Column="1"
                           LastChildFill="False">
                    <Grid DockPanel.Dock="Bottom"
                          ColumnDefinitions="0.5*, 0.5*">
                        <Button DockPanel.Dock="Bottom"
                                Grid.Column="0"
                                Classes="flat"
                                Width="60"
                                Height="60"
                                Margin="5"
                                IsEnabled="{Binding !IsPulseDurationWork}"
                                Command="{Binding StartPulseDurationCommand}">
                            <avalonia:MaterialIcon Kind="Play" Width="50" Height="50"/>
                        </Button>
                        <Button DockPanel.Dock="Bottom"
                                Grid.Column="1"
                                Width="60"
                                Height="60"
                                Classes="flat"
                                Margin="5"
                                IsEnabled="{Binding IsPulseDurationWork}"
                                Command="{Binding StopPulseDurationCommand}">
                            <avalonia:MaterialIcon Kind="Stop" Width="50" Height="50"/>
                        </Button>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom"
                               VerticalAlignment="Center"
                               Margin="5"
                               Text="{Binding PulsePeriod, StringFormat='Период импульса: {0}'}"/>
                </DockPanel>
            </Grid>
        </DockPanel>
        
        
    </controls:Card>
</UserControl>
